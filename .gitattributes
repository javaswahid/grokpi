# Normalize line endings for cross-platform (Go + TS/Next.js + Docker)
* text=auto

# Source code - prefer LF
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf

# Windows specific (keep CRLF if needed)
*.{cmd,ps1,bat} text eol=crlf

# Binary / assets - no normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.svg text
*.woff2 binary
*.ttf binary
